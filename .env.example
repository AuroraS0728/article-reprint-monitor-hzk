# Copy to .env for Docker Compose. Use unique local-only values; never commit secrets.
DJANGO_SECRET_KEY=change-me-to-a-long-random-local-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8080
DB_NAME=repost_monitor
DB_USER=repost_monitor
DB_PASSWORD=change-me-local-db-password
DB_ROOT_PASSWORD=change-me-local-root-password
DB_HOST=mysql
DB_PORT=3306
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
REPORT_ROOT=/app/reports
PRIVATE_UPLOAD_ROOT=/app/private_uploads
FIELD_ENCRYPTION_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SEARCH_PROVIDER=
BRAVE_SEARCH_API_KEY=
TENCENTCLOUD_WSA_APIKEY=
SEARCH_SIMILARITY_THRESHOLD=90
SEARCH_CANDIDATE_MIN_SIMILARITY=80
SEARCH_SHORT_TITLE_LENGTH=8
SEARCH_RESULT_LIMIT=20
SEARCH_REQUEST_TIMEOUT_SECONDS=15
SEARCH_MAX_RESPONSE_BYTES=2097152
SEARCH_PUBLISHED_TIME_TOLERANCE_HOURS=24
SEARCH_ERROR_BACKOFF_MINUTES=30
SEARCH_LOCK_TIMEOUT_SECONDS=300
SEARCH_SCHEDULER_BATCH_SIZE=100
ARTICLE_MONITOR_DAYS=7
ARTICLE_RETENTION_DAYS=365
ARTICLE_SEARCH_SCHEDULE_MINUTES=0,15,30,60,120,240,480
ARTICLE_SEARCH_REPEAT_MINUTES=720
