DJANGO_SETTINGS_MODULE=config.settings.production
APP_VERSION=v1.0.0
PRODUCTION_DATA_ROOT=/srv/article-reprint-monitor/data
PRODUCTION_ENV_FILE=deploy/production.env.example
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=monitor.wiseprop.online
DJANGO_CSRF_TRUSTED_ORIGINS=https://monitor.wiseprop.online
DJANGO_SECRET_KEY_FILE=/run/secrets/django_secret_key
DB_NAME=repost_monitor
DB_USER=repost_monitor
DB_PASSWORD_FILE=/run/secrets/db_password
DB_HOST=mysql
DB_PORT=3306
REDIS_PASSWORD_FILE=/run/secrets/redis_password
FIELD_ENCRYPTION_KEY_FILE=/run/secrets/field_encryption_key
REPORT_ROOT=/app/reports
PRIVATE_UPLOAD_ROOT=/app/private_uploads
SEARCH_PROVIDER=
BRAVE_SEARCH_API_KEY=
TENCENTCLOUD_WSA_APIKEY_FILE=/run/secrets/tencentcloud_wsa_apikey
ARTICLE_MONITOR_DAYS=7
ARTICLE_RETENTION_DAYS=365
ARTICLE_SEARCH_SCHEDULE_MINUTES=0,15,30,60,120,240,480
ARTICLE_SEARCH_REPEAT_MINUTES=720
